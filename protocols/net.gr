/**
 * Network Service
 * Provides the means to use networking by providing a socket interface.
 */
 
import "types"

namespace sys

enum close_options {
    READ = 0,
    WRITE = 1,
    READ_WRITE = 2,
    DESTROY = 3
}

enum address_type {
    THIS,
    PEER
}

// All socket construction paths return the same immutable type information
// and the existing reusable ring transfers. Connection state stays in netd.
struct socket_info {
    int          domain;
    int          type;
    int          protocol;
    shm_transfer recv_buffer;
    shm_transfer send_buffer;
}

service socket : message {
    func create(int domain, int type, int protocol) : (oserr_t result, grant_token reference, socket_info info) = 1;
    func close(uuid_t handle, close_options options) : (oserr_t result) = 2;
    func bind(uuid_t handle, uint8[] address) : (oserr_t result) = 3;
    func connect(uuid_t handle, uint8[] address) : (oserr_t result) = 4;
    func accept(uuid_t handle) : (oserr_t result, uint8[] address, grant_token reference, socket_info info) = 5;
    func listen(uuid_t handle, int backlog) : (oserr_t result) = 6;
    func pair(uuid_t handle1, uuid_t handle2) : (oserr_t result) = 7;
    func acquire(uuid_t handle) : (oserr_t result, socket_info info) = 8;
    func set_option(uuid_t handle, int protocol, uint optname, uint8[] data, int length) : (oserr_t result) = 9;
    func get_option(uuid_t handle, int protocol, uint optname) : (oserr_t result, uint8[] data, int length) = 10;
    func get_address(uuid_t handle, address_type type) : (oserr_t result, uint8[] address) = 11;
}
