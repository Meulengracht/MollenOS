/**
 * Shared types used by system services and contracts.
 */
 
namespace sys

define uuid_t from "os/osdefs.h"
define oserr_t from "os/osdefs.h"
define size_t from "stddef.h"
define uintptr_t from "stdint.h"
define time_t from "time.h"

// Grant token fields sent over IPC. export_id also supplies the native
// ControlHandleID. The four secret words store the 16 secret bytes in
// little-endian order.
struct grant_token {
    uint32 version;
    uint32 export_id;
    uint32 resource_type;
    uint32 data0;
    uint32 data1;
    uint32 target_id;
    uint32 scope;
    uint32 target_type;
    uint32 secret0;
    uint32 secret1;
    uint32 secret2;
    uint32 secret3;
}

// Grant token and byte range for one SHM operation.
// Full-range mode requires relative_offset and requested_length to be zero.
// For a subrange, relative_offset is measured from the start of the token's
// SHM range. The offset and requested length must fit within data1.
struct shm_transfer {
    grant_token token;
    uint32 range_mode;
    uint32 relative_offset;
    uint32 requested_length;
}

struct timestamp {
    time_t tv_sec;
    uint32 tv_nsec;
}

enum storage_flags {
    REMOVABLE = 1
}

struct disk_geometry {
    uint   sector_size;
    uint   sectors_per_cylinder;
    uint64 sectors_total;
    uint   lun_count;
}

struct disk_descriptor {
    uuid_t         device_id;
    uuid_t         driver_id;
    string         model;
    string         serial;
    storage_flags  flags;
    disk_geometry  geometry;
}

enum transfer_direction {
    READ,
    WRITE
}

// Device identifiers used to find a matching driver, with descriptive strings
// for displaying device information.
struct device_identification {
    uint32 vendor_id;
    uint32 product_id;
    uint32 class;
    uint32 subclass;

    string description;
    string manufacturer;
    string product;
    string revision;
    string serial;
}

// Device ID, parent ID and identification details.
struct device_base {
    uuid_t                id;
    uuid_t                parent_id;
    device_identification identification;
}

struct bus_io_memory {
    uintptr_t physical_base;
    uintptr_t virtual_base;
    size_t    length;
}

struct bus_io_port {
    uint16 base;
    size_t length;
}

struct bus_io_pin {
    uint16 port;
    uint8  pin;
}

struct bus_io {
    uuid_t id;
    variant access {
        bus_io_memory memory;
        bus_io_port port;
        bus_io_pin pin;
    }
}

enum bus_type {
    GENERIC = 0,
    PCI = 1
}

struct device_bus {
    device_base;
    bus_type type;
    int      irq_line;
    int      irq_pin;
    uint32   acpi_conform_flags;
    uint32   segment;
    uint32   bus;
    uint32   slot;
    uint32   function;
    bus_io[] ios;
}

struct device_usb {
    device_base;
	uuid_t controller_device_id;
	uuid_t controller_driver_id;
	uuid_t hub_device_id;
	uuid_t hub_driver_id;
    uint8  hub_address;
    uint8  port_address;
    uint8  device_address;
    uint16 configuration_length;
    uint16 device_mps;
    uint8  speed;
}

struct platform_register {
    uint64 base;
    uint64 length;
}

struct platform_interrupt {
    uint32 controller;
    uint32 number;
    uint32 type;
}

struct device_platform {
    device_base;
    uint32               version;
    uint32               pending;
    uint32               firmware_node;
    uint8[]              compatibles;
    platform_register[]  registers;
    platform_interrupt[] interrupts;
}

struct device {
    variant content {
        device_base base;
        device_bus  bus;
        device_usb  usb;
        device_platform platform;
    }
}
