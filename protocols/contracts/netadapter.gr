/**
 * Network Adapter Contract.
 *
 * Ethernet frame transport between netd and controller drivers. IP addresses,
 * routing, sockets and wireless association are outside this contract. Drivers
 * advertise the contract through the driver contract. Ports are zero-based.
 * This replaces the unused stat/queue sketch and is not wire-compatible with it.
 *
 * Sessions are exclusive per port and bound to the authenticated IPC peer.
 * IDs alone do not authorize access. A session/generation pair must never be
 * reused, including after driver restart. Reject stale generations everywhere.
 * Generation checks do not establish that old DMA has stopped.
 *
 * Payloads reside in registered SHM; messages carry metadata only. Acceptance
 * transfers a slot to the driver; rejection leaves it with netd. Each accepted
 * submission has one logical terminal completion, which may be delivered again.
 * No timeout, lost reply or fault event grants permission to recycle storage.
 * Unless stated otherwise, response data is valid only on OS_EOK.
 *
 */

import "../types"

namespace ctt

/**
 * Frames are at most 2048 bytes INCLUDING the 11-byte Gracht header.
 * Both endpoints configure transport buffers for that envelope. max_batch_size
 * is 1..44 (the 71 + 44*N byte recovery chunk is the largest at N=44). Smaller
 * advertised batches are allowed. This bounds serialization, not total queued
 * work: max_pending_batches controls the independent in-flight batch window.
 * All IDs/cursors are nonwrapping; close before exhausting their uint64 range.
 */
enum netadapter_limit {
    FRAME_BYTES = 2048,
    BATCH_RECORDS = 44
}

enum netadapter_framing {
    ETHERNET = 1
}

enum netadapter_medium {
    WIRED = 1,
    WIFI = 2,
    VIRTUAL = 3
}

enum netadapter_direction {
    TX = 1,
    RX = 2
}

enum netadapter_link_status {
    UNKNOWN = 0,
    DOWN = 1,
    UP = 2
}

enum netadapter_duplex {
    UNKNOWN = 0,
    HALF = 1,
    FULL = 2
}

// Bit masks for uint64 feature fields. No packet offloads are defined in ABI 2.
enum netadapter_feature {
    ALL_MULTICAST = 1,
    PROMISCUOUS = 2
}

// UNICAST | BROADCAST is required and is the default. UNICAST accepts the
// current MAC. Optional filter bits require the corresponding enabled feature.
enum netadapter_rx_filter {
    UNICAST = 1,
    BROADCAST = 2,
    ALL_MULTICAST = 4,
    PROMISCUOUS = 8
}

enum netadapter_completion_status {
    SUCCESS = 0,
    ERROR = 1,
    CANCELLED = 2
}

struct netadapter_mac {
    uint8 octet0;
    uint8 octet1;
    uint8 octet2;
    uint8 octet3;
    uint8 octet4;
    uint8 octet5;
}

struct netadapter_session {
    uint64 id;
    uint64 generation;
}

// Carrier is independent of administrative start/stop. Sequence starts at one
// and increases on every change within the session; zero speed means unknown.
struct netadapter_link {
    uint64                 sequence;
    netadapter_link_status status;
    netadapter_duplex      duplex;
    uint64                 speed_bps;
}

struct netadapter_info {
    uint32             port_count;
    uint32             min_version;
    uint32             max_version;
    netadapter_framing framing;
    netadapter_medium  medium;
    netadapter_mac     permanent_mac;
    netadapter_mac     current_mac;
    uint32             min_mtu;
    uint32             max_mtu;
    uint32             current_mtu;
    uint32             max_frame_size;
    uint32             buffer_alignment;
    uint32             required_headroom;
    uint32             required_tailroom;
    uint32             max_pools;
    uint64             max_pool_bytes;
    uint64             max_registered_bytes;
    uint32             max_slots_per_pool;
    uint32             max_queue_pairs;
    uint32             max_segments;
    uint32             max_batch_size;
    uint32             max_pending_batches;
    uint32             max_outstanding_tx;
    uint32             max_outstanding_rx;
    uint32             max_unacked_completions;
    uint32             min_rx_slots;
    uint64             supported_features;
}

/**
 * Slot N begins at region_offset + N * slot_size. slot_count * slot_size must
 * fit region_size. Validate overflow, SHM bounds/access, quotas, alignment and
 * overlapping registrations, including aliases of the same storage.
 * buffer_alignment is a nonzero power of two applying to each frame address.
 * Each slot reserves the advertised headroom/tailroom outside the frame.
 *
 * Pools have one direction; nonzero IDs are never reused within a session.
 * Drivers prepare DMA mappings or bounce buffers; clients supply no DMA address.
 * Registration transfers no slot ownership. Keep registered storage stable and
 * attached until successful unregister_pool or close.
 */
struct netadapter_pool {
    netadapter_direction direction;
    uuid_t               buffer_handle;
    uint64               region_offset;
    uint64               region_size;
    uint32               slot_size;
    uint32               slot_count;
}

struct netadapter_packet_id {
    uint32 queue_id;
    uint32 pool_id;
    uint32 slot_id;
    uint64 submission_sequence;
}

/**
 * queue_id is zero; max_queue_pairs and max_segments are one.
 * submission_sequence is nonzero and strictly increases per slot, including
 * rejected descriptors, except when replaying an identical batch. Remember the
 * last sequence per slot to reject stale submissions with bounded storage.
 * At most one accepted submission owns a slot. Generation comes from the session.
 *
 * data_offset is relative to the slot start. length is frame length for TX and
 * writable frame capacity for RX. Check offset <= slot_size and length <=
 * slot_size - offset, plus headroom/tailroom, alignment and frame limits.
 * flags must be zero. Snapshot descriptor metadata before admission.
 *
 * Frames begin at destination MAC, excluding preamble and FCS. MTU denotes
 * network-layer packet size, not frame or slot size. Driver-private headers
 * stay outside the frame. Drivers must initialize any short-frame padding.
 * No checksum validation/generation or VLAN insertion/stripping is requested:
 * netd supplies complete TX frames and validates received protocol checksums.
 */
struct netadapter_packet {
    netadapter_packet_id id;
    uint32               data_offset;
    uint32               length;
    uint32               flags;
}

// One entry per input descriptor, in input order. Only OS_EOK transfers ownership.
struct netadapter_admission {
    netadapter_packet_id id;
    oserr_t              status;
}

/**
 * Session-wide completion sequence starts at one, shared by TX and RX.
 * RX success returns actual length at the submitted offset; TX success returns
 * submitted length. Error/cancellation returns length zero and a detail reason;
 * success has detail OS_EOK. Deduplicate by completion_sequence.
 * TX completion releases hardware ownership, not TCP retransmission state.
 * RX completion forbids driver access until the slot is explicitly reposted.
 */
struct netadapter_completion {
    uint64                       completion_sequence;
    netadapter_direction         direction;
    netadapter_packet_id         id;
    netadapter_completion_status status;
    oserr_t                      detail;
    uint32                       length;
}

// Session-scoped counters; queries do not reset them. Byte counts exclude FCS
// and driver-private headers. Successful packet counts exclude cancellations.
struct netadapter_counters {
    uint64 tx_packets;
    uint64 tx_bytes;
    uint64 rx_packets;
    uint64 rx_bytes;
    uint64 tx_dropped;
    uint64 rx_dropped;
    uint64 tx_errors;
    uint64 rx_errors;
    uint64 tx_queue_full;
    uint64 rx_no_buffer;
    uint64 resets;
}

// Session-wide faults stop admission and require stop/close recovery. Zero
// operation_id/batch_id means no particular request. Packet errors use completions.
struct netadapter_fault {
    oserr_t status;
    uint32  operation_id;
    uint64  batch_id;
}

/**
 * Cumulative acknowledgements, initially zero. Advance only over a
 * contiguous prefix of consumed admission results / processed completions.
 * A batch ACK retires replay metadata, NOT packet ownership. Completion ACKs
 * retire journal records, NOT an unknown admission. Reject either cursor beyond
 * the driver's issued prefix atomically, applying neither acknowledgement.
 * Older valid cursors are no-ops. Sending an ACK does not yet restore client
 * credits; wait for confirmed retirement in netadapter_progress.
 */
struct netadapter_ack {
    uint64 through_batch_id;
    uint64 through_completion_sequence;
}

/**
 * Driver snapshot. All four cursors are session-wide, initially zero and
 * monotonic. retired_batch_id <= consumed_batch_id; retired_completion_sequence
 * <= highest_completion_sequence. Events can arrive out of order: validate each
 * snapshot, then merge cursor maxima without regressing local state. The client
 * must reject retirement beyond acknowledgements it actually published.
 *
 * consumed_batch_id/highest_completion_sequence reveal missing records; they
 * DO NOT grant ownership or authorize skipping them. Retired cursors confirm
 * that replay/journal capacity is reusable. Count unresolved submitted work
 * conservatively until admission is known; subtract each confirmed retirement
 * only once. No per-packet IPC is needed for these credits.
 */
struct netadapter_progress {
    uint64 retired_batch_id;
    uint64 retired_completion_sequence;
    uint64 consumed_batch_id;
    uint64 highest_completion_sequence;
}

service netadapter : message {
    // Port zero exists on every advertised device and reveals port_count.
    // Batch limits must fit the Gracht message size, including serialization.
    func get_info(uuid_t device_id, uint32 port_id) : (oserr_t status, netadapter_info info) = 1;

    // Unsupported requested feature bits fail open. Success
    // atomically installs directed event delivery and returns a link snapshot.
    // Events may precede this reply; use the link sequence to order updates.
    // An identical retry by the same owner returns its existing session/snapshot.
    // Changed features are not an identical retry and must fail rather
    // than switching a live session. Open happens with its run gate CLOSED.
    func open(uuid_t device_id, uint32 port_id, uint64 requested_features) : (oserr_t status, netadapter_session session, uint64 enabled_features, netadapter_link link) = 2;

    // Only while stopped, before posting RX. registration_id is a nonzero request
    // key. Identical retries return the original ID; conflicting retries fail.
    // A retry for a retired registration fails rather than recreating its pool.
    // Retain keys until close. max_pools limits successful registrations over the
    // session lifetime, including retired pools, to bound this replay storage.
    func register_pool(netadapter_session session, uint64 registration_id, netadapter_pool pool) : (oserr_t status, uint32 pool_id) = 3;

    // Only while stopped without outstanding descriptors or unacked completions.
    // Validate MTU against registered RX slot capacity. Identical retries are safe.
    func configure(netadapter_session session, uint32 mtu, uint32 rx_filter) : (oserr_t status) = 4;

    func get_link(netadapter_session session) : (oserr_t status, netadapter_link link) = 5;
    func get_counters(netadapter_session session) : (oserr_t status, netadapter_counters counters) = 6;

    // Stopped only; OS_EBUSY while backend/DMA references or unacked completions
    // refer to the pool. An already unregistered ID succeeds again.
    func unregister_pool(netadapter_session session, uint32 pool_id) : (oserr_t status) = 7;

    // Safe stop followed by release. OS_EOK is a final ownership barrier even if
    // completion delivery failed: all slots may be reclaimed, records discarded.
    // Remember closed generations so a repeated close succeeds without touching a
    // newer session. Failed/uncertain close never authorizes freeing DMA memory.
    func close(netadapter_session session) : (oserr_t status) = 8;

    event link_changed : (netadapter_session session, netadapter_link link) = 9;
    event fault : (netadapter_session session, netadapter_fault fault) = 10;

    /**
     * Submissions. These functions are ONE-WAY: transport publication is
     * not admission. Each outcome is reported by batch_admitted. The caller can
     * have up to max_pending_batches unretired batches in flight, without waiting
     * for a round trip between publications. Retain immutable descriptor arrays
     * and do not reuse their slots while admission is uncertain.
     *
     * Batch IDs start at one, increase across BOTH directions and all runs, and
     * never wrap. A first-time batch consumes exactly consumed_batch_id + 1.
     * A gap or full replay window emits OS_EBUSY, consumes no ID and admits no
     * descriptors on THAT attempt. Retry gaps in order with the original IDs;
     * delayed non-consuming errors cannot undo a previously consumed batch.
     *
     * OS_EOK consumes the ID and stores one ordered admission per descriptor,
     * even when all descriptors are individually rejected. Reserve the replay
     * entry first and terminal-completion capacity before accepting each packet.
     * Snapshot/validate input metadata before DMA. Batch shape is 1..max_batch_size.
     * Other batch statuses carry an empty array, consume no ID and do not release
     * uncertain slots. Exhausted retry budgets require safe-close recovery.
     *
     * Replay identity is (session, run_id, direction, batch_id, descriptors).
     * Identical retries re-emit cached admission, never repeat publication.
     * Changed descriptors/direction for a cached ID fail OS_EPROTOCOL.
     * ACKs are deliberately outside replay identity and may advance on a retry.
     * Validate ACKs atomically before processing a batch; invalid ACKs fail the
     * attempt. IDs <= retired_batch_id fail OS_ENOENT, never execute again.
     * Stale run IDs fail OS_ENOENT. Apply valid ACKs even on busy/replayed attempts
     * so a full replay window cannot prevent its own retirement.
     *
     * One executor defines batch consumption order. Accepted TX preserves that
     * order. Admission events can arrive out of order; clients collect a bounded
     * window and ACK only its contiguous consumed prefix. Completions may precede
     * admissions. Reserve scheduling/credits for RX repost and recovery under TX
     * saturation; do not gate all data work on one pending control transaction.
     */
    // New admission only for the current PREPARED or RUNNING run. Cached replay
    // for that run remains allowed while STOPPING/STOPPED until retirement.
    // After stop_run, RX
    // cannot be posted until prepare_run explicitly opens the next run's gate.
    func post_rx_batch(netadapter_session session, uint64 run_id, uint64 batch_id, netadapter_ack ack, netadapter_packet[] packets) : () = 11;

    // New admission for current RUNNING run only; cached replay follows post_rx_batch.
    // Carrier rejection is a per-descriptor admission.
    func submit_tx_batch(netadapter_session session, uint64 run_id, uint64 batch_id, netadapter_ack ack, netadapter_packet[] packets) : () = 12;

    /**
     * Idle retirement path. Always emit ack_progress, even for duplicate
     * ACKs, so lost confirmations are recoverable without subsequent traffic.
     * Piggyback the same cursors on submissions/drains when possible. A bounded
     * flush/retry deadline is required while retirement remains unconfirmed;
     * fully idle, confirmed sessions need no ACK heartbeat. Wrong-owner sessions
     * are dropped without directed information disclosure.
     */
    func acknowledge(netadapter_session session, netadapter_ack ack) : () = 13;

    /**
     * Recovery enumeration, not the normal delivery path. request_id is a
     * nonzero, strictly increasing enumeration-attempt ID, NOT a submission key.
     * Keep the highest seen ID; ignore duplicate/older requests. Each validated
     * session request consumes its attempt ID even on ACK/cursor/busy errors.
     * Each retry uses
     * a NEW request_id and the client's contiguous processed completion cursor.
     * An attempt selects at most limit records (1..max_batch_size) from one
     * snapshot, beginning at after_sequence + 1. Emit ascending nonempty chunks
     * then drain_end, including an end for an empty successful enumeration.
     *
     * Apply valid ACKs before selecting a snapshot. Cursor below retired yields
     * OS_ENOENT, above highest yields OS_EINVALPARAMS; errors emit no chunks.
     * Progress on the end lets a client diagnose concurrent cursor retirement.
     * At most one snapshot is retained per session; a newer request while busy
     * gets OS_EBUSY/end (and consumes its request_id), without replacing the active
     * snapshot. Snapshot storage is at most max_batch_size copied records, so
     * concurrent journal retirement cannot invalidate queued enumeration bytes.
     *
     * Never block the hardware/completion executor on event delivery. If delivery
     * fails, release snapshot storage after a bounded attempt; journal records
     * remain until ACK. Missing chunks/end trigger a fresh enumeration attempt.
     * Interleaved live/recovery events are deduplicated by completion_sequence.
     * An end marker is NOT proof that missing chunks were processed. Timers also
     * recover a lost final live event when no later sequence reveals the gap.
     */
    func drain(netadapter_session session, uint64 request_id, uint64 after_sequence, uint32 limit, netadapter_ack ack) : () = 14;

    /**
     * Run lifecycle: OPENED -> PREPARED -> RUNNING -> STOPPING -> STOPPED.
     * prepare_run requires registered/configured pools. First run_id is one;
     * subsequent IDs increase exactly by one and require the prior stop barrier
     * AND all consumed batches acknowledged. Batch/completion IDs never reset.
     * No descriptors may be posted before prepare_run. A repeat for the current
     * run in PREPARED/RUNNING succeeds without resetting it; STOPPED cannot be
     * reopened with the same ID. Older/future IDs fail without state changes.
     * This explicit gate prevents delayed old RX postings from reviving DMA.
     */
    func prepare_run(netadapter_session session, uint64 run_id) : (oserr_t status) = 15;

    // Current PREPARED run only, with min_rx_slots admitted. Netd resolves
    // every published prepost batch first; through_batch_id must equal consumed
    // high-water at first start. Repeat of the same (run, fence) while RUNNING
    // succeeds without restarting hardware, even after more batches are consumed.
    // Altered retries fail; start for a stopped/older run cannot restart it.
    func start_run(netadapter_session session, uint64 run_id, uint64 through_batch_id) : (oserr_t status) = 16;

    /**
     * Stop fence: client freezes publications and resolves EVERY previously
     * published batch to a consumed admission before issuing this call. If that
     * is impossible (e.g. a non-consuming failure cannot recover), use close.
     * through_batch_id must equal the driver's consumed high-water at first stop.
     * Driver atomically closes this run's admission gate before quiescing DMA.
     * No subsequent new batch can enter this run, including after a failed stop.
     * An identical retry may continue quiescence; a changed fence is invalid.
     *
     * OS_EOK returns a terminal-completion barrier for every accepted descriptor.
     * Client drains/ACKs that barrier before prepare_run for the next run. A
     * successful repeated stop of the same run/fence returns its saved barrier,
     * without cancelling a newer run. Only current-run replay state need be kept;
     * once prepare_run advances, older lifecycle calls fail OS_ENOENT safely.
     * Stop is valid in PREPARED as well as RUNNING. No failure grants ownership.
     */
    func stop_run(netadapter_session session, uint64 run_id, uint64 through_batch_id) : (oserr_t status, uint64 final_completion_sequence) = 17;

    // Directed admission; status/progress are meaningful even on failure.
    // The array is valid only on OS_EOK and must exactly match submitted IDs/order.
    // Failed delivery retains the cached result for an identical batch replay.
    event batch_admitted : (netadapter_session session, uint64 run_id, uint64 batch_id, oserr_t status, netadapter_admission[] admissions, netadapter_progress progress) = 18;

    // Unified TX/RX journal stream. request_id=0 means normal pushed work;
    // nonzero identifies a drain chunk. Nonempty array <= max_batch_size, ascending
    // contiguous sequences WITHIN each chunk. Across chunks/events delivery may
    // reorder or repeat. Driver coalesces available records without waiting for a
    // full batch, applies a bounded flush deadline, and retains the journal on send
    // failure. No drain/end round trip is required for normal live completions.
    event completions : (netadapter_session session, uint64 request_id, netadapter_completion[] records, netadapter_progress progress) = 19;

    // Recovery end. Success: after_sequence echoes request, count<=limit,
    // through_sequence=after_sequence+count <= snapshot_highest. Chunks contain
    // exactly that selected prefix, regardless of newer live records. Empty
    // success has through_sequence=after_sequence. On error count=0, through is
    // after_sequence and no chunks belong to this attempt; snapshot_highest and
    // progress remain diagnostic snapshots. Validate prefix completeness before
    // marking enumeration done; ACK only records actually processed contiguously.
    event drain_end : (netadapter_session session, uint64 request_id, oserr_t status, uint64 after_sequence, uint64 through_sequence, uint32 count, uint64 snapshot_highest, netadapter_progress progress) = 20;

    // Standalone ACK confirmation, also used after duplicate ACKs. Echo
    // identifies requested cursors; status OS_EOK confirms they were valid, while
    // progress reports actual retirement. Invalid ACKs change neither cursor.
    // Lost confirmation is recovered by resending the same cumulative ACK.
    event ack_progress : (netadapter_session session, netadapter_ack ack, oserr_t status, netadapter_progress progress) = 21;
}
