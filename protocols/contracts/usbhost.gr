/**
 * UsbHost Contract
 * Provides usb host related functionality to the drivers that implement this. The contracts
 * supported by each driver can be queried through the driver contract.
 */
 
import "../types"

namespace ctt

enum usb_transfer_status {
    SUCCESS,
    CANCELLED,
    NOBANDWIDTH,
    STALL,
    NORESPONSE,
    DATATOGGLEMISMATCH,
    BUFFERERROR,
    NAK,
    BABBLE
}

enum usb_transfer_type {
    CONTROL,
    BULK,
    INTERRUPT,
    ISOCHRONOUS
}

enum usb_transfer_direction {
    IN,
    OUT
}

enum usb_speed {
    LOW,
    FULL,
    HIGH,
    SUPER,
    SUPER_PLUS
}

// Endpoint metadata and the exact setup/data or periodic buffer range.
struct usb_transfer {
    uint8                  hub_address;
    uint8                  port_address;
    uint8                  device_address;
    uint8                  endpoint_address;
    usb_transfer_type      type;
    usb_transfer_direction direction;
    usb_speed              speed;
    uint16                 max_packet_size;
    uint16                 flags;
    uint8                  periodic_bandwidth;
    uint8                  periodic_interval;
    shm_transfer           buffer;
}

service usbhost : message {
    func queue(uuid_t processId, uuid_t deviceId, uuid_t transferId, usb_transfer transfer) : (oserr_t status, usb_transfer_status result, ulong bytesTransferred) = 1;
    func queue_periodic(uuid_t processId, uuid_t deviceId, uuid_t transferId, usb_transfer transfer) : (oserr_t result) = 2;
    func reset_periodic(uuid_t processId, uuid_t deviceId, uuid_t transferId) : (oserr_t result) = 3;
    func dequeue(uuid_t processId, uuid_t deviceId, uuid_t transferId) : (oserr_t result) = 4;
    func reset_endpoint(uuid_t deviceId, uint8 hub, uint8 port, uint8 device, uint8 endpoint) : (oserr_t result) = 5;
    func configure_hub(uuid_t deviceId, uint8 hubAddress, uint8 portCount, uint16 characteristics) : (oserr_t result) = 7;
    func device_detach(uuid_t controllerDeviceId, uint8 hubAddress, uint8 portAddress, uint8 deviceAddress) : (oserr_t result) = 8;

    event transfer_status : (uuid_t transferId, usb_transfer_status status, ulong dataIndex) = 6;
}
