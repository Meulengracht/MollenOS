$(OUTPUT_DIR)/VBoot.efi : $(DEBUG_DIR)/VBoot.dll
	"$(GENFW)" -e $(MODULE_TYPE) -o /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/VBoot.efi /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/DEBUG/VBoot.dll $(GENFW_FLAGS)
	$(CP) /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/VBoot.efi $(DEBUG_DIR)
	$(CP) /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/VBoot.efi $(BIN_DIR)/$(MODULE_NAME_GUID).efi
	-$(CP) $(DEBUG_DIR)/*.map $(OUTPUT_DIR)
	-$(CP) $(DEBUG_DIR)/*.pdb $(OUTPUT_DIR)

$(OUTPUT_DIR)/VBoot.map : $(OUTPUT_DIR)/VBoot.efi
	

$(DEBUG_DIR)/VBoot.efi : $(OUTPUT_DIR)/VBoot.efi
	

$(OUTPUT_DIR)/arm64/trampoline.obj : $(MAKE_FILE)
$(OUTPUT_DIR)/arm64/trampoline.obj : $(DEBUG_DIR)/AutoGen.h
$(OUTPUT_DIR)/arm64/trampoline.obj : /home/philip/Projects/vali/boot/uefi/arm64/trampoline.S
	Trim --asm-file -o /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.i -i $(INC_LIST) /home/philip/Projects/vali/boot/uefi/arm64/trampoline.S
	"$(PP)" $(DEPS_FLAGS) $(PP_FLAGS) $(INC) /home/philip/Projects/vali/boot/uefi/arm64/trampoline.S > /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.ii
	Trim --trim-long --source-code -o /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.iiii /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.ii
	"$(ASM)" $(ASM_FLAGS) -o /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.obj $(INC) /home/philip/Projects/vali/boot/uefi/efi/Build/VBoot/RELEASE_CLANGPDB/AARCH64/VBoot/OUTPUT/arm64/trampoline.iiii



#
# clean all intermediate files
#
clean:
	$(RD) $(OUTPUT_DIR)
		$(RM) AutoGenTimeStamp

#
# clean all generated files
#
cleanall:
	$(RD) $(DEBUG_DIR)
	$(RD) $(OUTPUT_DIR)
	$(RM) *.pdb *.idb > NUL 2>&1
	$(RM) $(BIN_DIR)/$(MODULE_NAME).efi
	$(RM) AutoGenTimeStamp

