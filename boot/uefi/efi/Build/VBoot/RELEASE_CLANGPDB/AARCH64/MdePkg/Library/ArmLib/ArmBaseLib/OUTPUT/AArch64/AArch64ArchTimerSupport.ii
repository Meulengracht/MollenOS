        .macro rvhe, reg, sysreg, altname
        mrs \reg, CurrentEL
        tbz \reg, #3, .L\@
        mrs \reg, hcr_el2
        tbz \reg, #34, .L\@
        mrs \reg, \altname
        ret
.L\@: mrs \reg, \sysreg
        ret
        .endm


        .macro wvhe, sysreg, reg, altname, tmp
        mrs \tmp, CurrentEL
        tbz \tmp, #3, .L\@
        mrs \tmp, hcr_el2
        tbz \tmp, #34, .L\@
        msr \altname, \reg
        ret
.L\@: msr \sysreg, \reg
        ret
        .endm

