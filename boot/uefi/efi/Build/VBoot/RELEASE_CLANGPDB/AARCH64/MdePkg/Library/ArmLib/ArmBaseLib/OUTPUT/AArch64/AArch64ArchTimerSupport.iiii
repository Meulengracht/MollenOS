        .macro rvhe, reg, sysreg, altname
        mrs \reg, CurrentEL
        tbz \reg, #3, .L\@
        mrs \reg, hcr_el2
        tbz \reg, #34, .L\@
        mrs \reg, \altname
        ret
.L\@: mrs \reg, \sysreg
        ret
        .endm


        .macro wvhe, sysreg, reg, altname, tmp
        mrs \tmp, CurrentEL
        tbz \tmp, #3, .L\@
        mrs \tmp, hcr_el2
        tbz \tmp, #34, .L\@
        msr \altname, \reg
        ret
.L\@: msr \sysreg, \reg
        ret
        .endm

.global ArmReadCntFrq ; .section ".text.ArmReadCntFrq", "ax" ; ; ArmReadCntFrq: ;
  mrs x0, cntfrq_el0
  ret


 # NOTE - Can only write while at highest implemented EL level (EL3 on model). Else ReadOnly (EL2, EL1, EL0)
.global ArmWriteCntFrq ; .section ".text.ArmWriteCntFrq", "ax" ; ; ArmWriteCntFrq: ;
  msr cntfrq_el0, x0
  ret


.global ArmReadCntPct ; .section ".text.ArmReadCntPct", "ax" ; ; ArmReadCntPct: ;
  mrs x0, cntpct_el0
  ret


.global ArmReadCntkCtl ; .section ".text.ArmReadCntkCtl", "ax" ; ; ArmReadCntkCtl: ;
