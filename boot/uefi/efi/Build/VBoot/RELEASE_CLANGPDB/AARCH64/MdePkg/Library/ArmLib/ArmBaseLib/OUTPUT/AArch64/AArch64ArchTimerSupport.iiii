  ret


.global ArmWriteCntkCtl ; .section ".text.ArmWriteCntkCtl", "ax" ; ; ArmWriteCntkCtl: ;
  msr cntkctl_el1, x0
  ret


.global ArmReadCntpTval ; .section ".text.ArmReadCntpTval", "ax" ; ; ArmReadCntpTval: ;
  rvhe x0, cntp_tval_el0, s3_5_c14_c2_0


.global ArmWriteCntpTval ; .section ".text.ArmWriteCntpTval", "ax" ; ; ArmWriteCntpTval: ;
  wvhe cntp_tval_el0, x0, s3_5_c14_c2_0, x1


