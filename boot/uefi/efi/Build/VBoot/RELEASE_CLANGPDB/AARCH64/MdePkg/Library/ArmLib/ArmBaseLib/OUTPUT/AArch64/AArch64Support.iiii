.global ArmWriteVBar ; .section ".text.ArmWriteVBar", "ax" ; ; ArmWriteVBar: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: msr vbar_el1, x0
   b 4f
2: msr vbar_el2, x0
4: isb
