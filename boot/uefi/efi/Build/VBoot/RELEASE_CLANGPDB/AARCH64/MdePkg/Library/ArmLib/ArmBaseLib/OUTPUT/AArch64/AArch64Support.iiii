.global ArmReadVBar ; .section ".text.ArmReadVBar", "ax" ; ; ArmReadVBar: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: mrs x0, vbar_el1
   ret
2: mrs x0, vbar_el2
   ret

.global ArmEnableVFP ; .section ".text.ArmEnableVFP", "ax" ; ; ArmEnableVFP: ;


  mrs x0, cpacr_el1
  orr x0, x0, #CPACR_VFP_BITS
  msr cpacr_el1, x0
  mov x1, #(1 << 10)
  mrs x2, CurrentEL ; cmp x2, #0x8 ; b.gt . ; b.eq 2f ; cbnz x2, 1f ; b . ;
1:ret
2:mrs x0, cptr_el2
  bic x0, x0, x1
  msr cptr_el2, x0
  ret


