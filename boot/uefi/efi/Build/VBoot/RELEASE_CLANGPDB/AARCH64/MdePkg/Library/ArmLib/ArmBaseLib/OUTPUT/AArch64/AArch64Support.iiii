.set CTRL_M_BIT, (1 << 0)
.set CTRL_A_BIT, (1 << 1)
.set CTRL_C_BIT, (1 << 2)
.set CTRL_SA_BIT, (1 << 3)
.set CTRL_I_BIT, (1 << 12)
.set CTRL_V_BIT, (1 << 12)
.set CPACR_VFP_BITS, (3 << 20)

.global ArmInvalidateDataCacheEntryByMVA ; .section ".text.ArmInvalidateDataCacheEntryByMVA", "ax" ; ; ArmInvalidateDataCacheEntryByMVA: ;
  dc ivac, x0
  ret


.global ArmCleanDataCacheEntryByMVA ; .section ".text.ArmCleanDataCacheEntryByMVA", "ax" ; ; ArmCleanDataCacheEntryByMVA: ;
  dc cvac, x0
  ret


.global ArmCleanDataCacheEntryToPoUByMVA ; .section ".text.ArmCleanDataCacheEntryToPoUByMVA", "ax" ; ; ArmCleanDataCacheEntryToPoUByMVA: ;
  dc cvau, x0
  ret

.global ArmInvalidateInstructionCacheEntryToPoUByMVA ; .section ".text.ArmInvalidateInstructionCacheEntryToPoUByMVA", "ax" ; ; ArmInvalidateInstructionCacheEntryToPoUByMVA: ;
  ic ivau, x0
  ret


.global ArmCleanInvalidateDataCacheEntryByMVA ; .section ".text.ArmCleanInvalidateDataCacheEntryByMVA", "ax" ; ; ArmCleanInvalidateDataCacheEntryByMVA: ;
  dc civac, x0
  ret

.global ArmInvalidateInstructionCache ; .section ".text.ArmInvalidateInstructionCache", "ax" ; ; ArmInvalidateInstructionCache: ;
  ic iallu
  dsb sy
  isb
  ret


.global ArmEnableMmu ; .section ".text.ArmEnableMmu", "ax" ; ; ArmEnableMmu: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: mrs x0, sctlr_el1
   b 4f
2: mrs x0, sctlr_el2
4: orr x0, x0, #CTRL_M_BIT
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: tlbi vmalle1
   dsb nsh
   isb
   msr sctlr_el1, x0
   b 4f
2: tlbi alle2
   dsb nsh
   isb
   msr sctlr_el2, x0
4: isb
   ret


.global ArmDisableMmu ; .section ".text.ArmDisableMmu", "ax" ; ; ArmDisableMmu: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: mrs x0, sctlr_el1
   b 4f
2: mrs x0, sctlr_el2
4: and x0, x0, #~CTRL_M_BIT
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: msr sctlr_el1, x0
   tlbi vmalle1
   b 4f
2: msr sctlr_el2, x0
   tlbi alle2
4: dsb sy
   isb
   ret


.global ArmDisableCachesAndMmu ; .section ".text.ArmDisableCachesAndMmu", "ax" ; ; ArmDisableCachesAndMmu: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: mrs x0, sctlr_el1
   b 4f
2: mrs x0, sctlr_el2
4: mov x1, #~(CTRL_M_BIT | CTRL_C_BIT | CTRL_I_BIT)
   and x0, x0, x1
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: msr sctlr_el1, x0
   b 4f
2: msr sctlr_el2, x0
4: dsb sy
   isb
   ret


.global ArmMmuEnabled ; .section ".text.ArmMmuEnabled", "ax" ; ; ArmMmuEnabled: ;
   mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1: mrs x0, sctlr_el1
   b 4f
2: mrs x0, sctlr_el2
4: and x0, x0, #CTRL_M_BIT
   ret


