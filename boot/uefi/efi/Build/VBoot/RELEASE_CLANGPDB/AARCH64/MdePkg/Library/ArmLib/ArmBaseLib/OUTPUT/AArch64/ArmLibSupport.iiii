.set DAIF_RD_FIQ_BIT, (1 << 6)
.set DAIF_RD_IRQ_BIT, (1 << 7)

.set SCTLR_ELx_M_BIT_POS, (0)

.global ArmReadAidr ; .section ".text.ArmReadAidr", "ax" ; ; ArmReadAidr: ;
  mrs x0, aidr_el1
  ret

.global ArmReadMidr ; .section ".text.ArmReadMidr", "ax" ; ; ArmReadMidr: ;
  mrs x0, midr_el1
  ret

.global ArmCacheInfo ; .section ".text.ArmCacheInfo", "ax" ; ; ArmCacheInfo: ;
  mrs x0, ctr_el0
  ret

.global ArmGetInterruptState ; .section ".text.ArmGetInterruptState", "ax" ; ; ArmGetInterruptState: ;
  mrs x0, daif
  tst w0, #DAIF_RD_IRQ_BIT
  cset w0, eq
  ret

.global ArmGetFiqState ; .section ".text.ArmGetFiqState", "ax" ; ; ArmGetFiqState: ;
  mrs x0, daif
  tst w0, #DAIF_RD_FIQ_BIT
  cset w0, eq
  ret

.global ArmWriteCpacr ; .section ".text.ArmWriteCpacr", "ax" ; ; ArmWriteCpacr: ;
  msr cpacr_el1, x0
  ret

.global ArmWriteAuxCr ; .section ".text.ArmWriteAuxCr", "ax" ; ; ArmWriteAuxCr: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:msr actlr_el1, x0
  ret
2:msr actlr_el2, x0
  ret

.global ArmReadAuxCr ; .section ".text.ArmReadAuxCr", "ax" ; ; ArmReadAuxCr: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:mrs x0, actlr_el1
  ret
2:mrs x0, actlr_el2
  ret

.global ArmSetTTBR0 ; .section ".text.ArmSetTTBR0", "ax" ; ; ArmSetTTBR0: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:msr ttbr0_el1, x0
  b 4f
2:msr ttbr0_el2, x0
4:isb
  ret

.global ArmGetTTBR0BaseAddress ; .section ".text.ArmGetTTBR0BaseAddress", "ax" ; ; ArmGetTTBR0BaseAddress: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:mrs x0, ttbr0_el1
  b 3f
2:mrs x0, ttbr0_el2
3:and x0, x0, 0xFFFFFFFFFFFF
  isb
  ret

.global ArmGetTCR ; .section ".text.ArmGetTCR", "ax" ; ; ArmGetTCR: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:mrs x0, tcr_el1
  b 4f
2:mrs x0, tcr_el2
4:isb
  ret

.global ArmSetTCR ; .section ".text.ArmSetTCR", "ax" ; ; ArmSetTCR: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:msr tcr_el1, x0
  b 4f
2:msr tcr_el2, x0
4:isb
  ret

.global ArmGetMAIR ; .section ".text.ArmGetMAIR", "ax" ; ; ArmGetMAIR: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:mrs x0, mair_el1
  b 4f
2:mrs x0, mair_el2
4:isb
  ret

.global ArmSetMAIR ; .section ".text.ArmSetMAIR", "ax" ; ; ArmSetMAIR: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:msr mair_el1, x0
  b 4f
2:msr mair_el2, x0
4:isb
  ret








.global ArmUpdateTranslationTableEntry ; .section ".text.ArmUpdateTranslationTableEntry", "ax" ; ; ArmUpdateTranslationTableEntry: ;
   dsb nshst
   lsr x1, x1, #12
   mrs x2, CurrentEL ; cmp x2, #0x8 ; b.gt . ; b.eq 2f ; cbnz x2, 1f ; b . ;
1: tlbi vaae1, x1
   mrs x2, sctlr_el1
   b 4f
2: tlbi vae2, x1
   mrs x2, sctlr_el2
4: tbnz x2, SCTLR_ELx_M_BIT_POS, 5f
   dc ivac, x0
5: dsb nsh
   isb
   ret

.global ArmInvalidateTlb ; .section ".text.ArmInvalidateTlb", "ax" ; ; ArmInvalidateTlb: ;
   mrs x0, CurrentEL ; cmp x0, #0x8 ; b.gt . ; b.eq 2f ; cbnz x0, 1f ; b . ;
1: tlbi vmalle1
   b 4f
2: tlbi alle2
4: dsb sy
   isb
   ret

.global ArmCallWFE ; .section ".text.ArmCallWFE", "ax" ; ; ArmCallWFE: ;
  wfe
  ret

.global ArmCallSEV ; .section ".text.ArmCallSEV", "ax" ; ; ArmCallSEV: ;
  sev
  ret

.global ArmReadCpuActlr ; .section ".text.ArmReadCpuActlr", "ax" ; ; ArmReadCpuActlr: ;
  mrs x0, S3_1_c15_c2_0
  ret

.global ArmWriteCpuActlr ; .section ".text.ArmWriteCpuActlr", "ax" ; ; ArmWriteCpuActlr: ;
  msr S3_1_c15_c2_0, x0
  dsb sy
  isb
  ret

.global ArmReadSctlr ; .section ".text.ArmReadSctlr", "ax" ; ; ArmReadSctlr: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:mrs x0, sctlr_el1
  ret
2:mrs x0, sctlr_el2
  ret

.global ArmWriteSctlr ; .section ".text.ArmWriteSctlr", "ax" ; ; ArmWriteSctlr: ;
  mrs x1, CurrentEL ; cmp x1, #0x8 ; b.gt . ; b.eq 2f ; cbnz x1, 1f ; b . ;
1:msr sctlr_el1, x0
  ret
2:msr sctlr_el2, x0
  ret

.global ArmGetPhysicalAddressBits ; .section ".text.ArmGetPhysicalAddressBits", "ax" ; ; ArmGetPhysicalAddressBits: ;
  mrs x0, id_aa64mmfr0_el1
  adr x1, .LPARanges
  and x0, x0, #0xf
  ldrb w0, [x1, x0]
  ret







.LPARanges:
  .byte 32, 36, 40, 42, 44, 48, 52, 0
  .byte 0, 0, 0, 0, 0, 0, 0, 0
